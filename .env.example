APP_ENV=development
APP_VERSION=4.2.1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/youtube_ai
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

GOOGLE_CLIENT_SECRETS_FILE=/app/secrets/client_secret.json
APP_ENCRYPTION_KEY=

LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

RESEARCH_PROVIDER=mock
RESEARCH_ENDPOINT=
RESEARCH_API_KEY=
RESEARCH_TIMEOUT_SECONDS=30

TTS_PROVIDER=espeak
VISUAL_PROVIDER=mock_png
VISUAL_ENDPOINT=
VISUAL_API_KEY=
VISUAL_MODEL=
PEXELS_API_KEY=

# v3.0 AI production providers
IMAGE_PROVIDER=mock_png
IMAGE_ENDPOINT=
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
VIDEO_PROVIDER=mock_video
VIDEO_ENDPOINT=
VIDEO_API_KEY=
VIDEO_MODEL=
VIDEO_POLL_SECONDS=5
VIDEO_TIMEOUT_SECONDS=900
TTS_ENDPOINT=
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
TTS_INSTRUCTIONS=

OUTPUT_DIR=./data/output
WORKFLOW_ENABLED=true
WORKFLOW_POLL_SECONDS=1
WORKFLOW_LEASE_SECONDS=1800
RESEARCH_SCHEDULER_ENABLED=true
RESEARCH_SCHEDULER_POLL_SECONDS=30
RESEARCH_SCHEDULER_BATCH_SIZE=3
RESEARCH_SCHEDULER_LEASE_MINUTES=20

# Observability
METRICS_PUBLIC=false
READINESS_TIMEOUT_SECONDS=3
PROVIDER_HEALTH_ENABLED=true
# v1.7 Research Intelligence
YOUTUBE_RESEARCH_API_KEY=
YOUTUBE_RESEARCH_REGION_CODE=US
YOUTUBE_RESEARCH_LANGUAGE=en
YOUTUBE_RESEARCH_ORDER=viewCount

# Authentication / SaaS
AUTH_DEV_FALLBACK=true
AUTH_SESSION_TTL_DAYS=30
API_KEY_DEFAULT_TTL_DAYS=365
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
AUTH_COOKIE_NAME=youtube_ai_session
CSRF_TOKEN_HEADER=X-CSRF-Token

# Deployment / reliability
AUTO_MIGRATE=true
SCHEMA_GATE_ENABLED=true
DEPLOYMENT_ENV=development
RELEASE_ID=local
UVICORN_WORKERS=2

# Billing
BILLING_PROVIDER=mock
BILLING_CURRENCY=USD
BILLING_WEBHOOK_SECRET=
BILLING_RETURN_URL=http://localhost:3000/billing
BILLING_WEBHOOK_SECRETS=
BILLING_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_SECRET_KEY=
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_TIMEOUT_SECONDS=20
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

THUMBNAIL_PROVIDER=pillow

# v3.0 Real AI providers
OPENAI_API_KEY=


POSTPUBLISH_ENABLED=true
POSTPUBLISH_POLL_SECONDS=60

CREATIVE_INTELLIGENCE_ENABLED=true
CREATIVE_FRAME_INTERVAL_SECONDS=3
CREATIVE_MAX_FRAMES=12
CREATIVE_SIMILARITY_THRESHOLD=0.08
VISION_PROVIDER=mock
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-5.6-luna
VISION_TIMEOUT_SECONDS=60

MULTIMODAL_GRAPH_ENABLED=true
MULTIMODAL_VISION_ENABLED=true
MULTIMODAL_MAX_FRAMES=8
MULTIMODAL_PREFLIGHT_HARD_FAIL=true

# v3.7 Autonomous Optimization / v3.8 Autonomous Execution
OPTIMIZATION_AI_ENABLED=true
OPTIMIZATION_MIN_CONFIDENCE=0.60
OPTIMIZATION_DEFAULT_MAX_ACTIONS=3
OPTIMIZATION_AUTO_EXECUTE=false

# v3.9 Agent Governance
GOVERNANCE_ENABLED=true
GOVERNANCE_APPROVAL_TIMEOUT_MINUTES=120
GOVERNANCE_DEFAULT_MODE=approve
GOVERNANCE_GLOBAL_KILL_SWITCH=false
