APP_ENV=production
APP_VERSION=4.2.4
DEPLOYMENT_ENV=production
RELEASE_ID=replace-with-release-id
AUTO_MIGRATE=false
SCHEMA_GATE_ENABLED=true
UVICORN_WORKERS=2

POSTGRES_DB=youtube_ai
POSTGRES_USER=youtube_ai
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgresql+asyncpg://youtube_ai:replace-with-strong-password@db:5432/youtube_ai

PUBLIC_BASE_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
APP_ENCRYPTION_KEY=replace-with-64-byte-secret
APP_ENCRYPTION_KEY_PREVIOUS=
AUTH_DEV_FALLBACK=false
AUTH_SESSION_TTL_DAYS=30
API_KEY_DEFAULT_TTL_DAYS=365
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
AUTH_COOKIE_NAME=__Host-youtube_ai_session
CSRF_TOKEN_HEADER=X-CSRF-Token

GOOGLE_CLIENT_SECRETS_FILE=/app/secrets/client_secret.json
# Optional secure env-based alternative to the file above. Store the complete Google OAuth JSON here in Railway.
GOOGLE_CLIENT_SECRETS_JSON=

LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=replace-with-supported-model
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=3

RESEARCH_PROVIDER=youtube_data
RESEARCH_ENDPOINT=
RESEARCH_API_KEY=
RESEARCH_TIMEOUT_SECONDS=30
YOUTUBE_RESEARCH_API_KEY=
YOUTUBE_RESEARCH_REGION_CODE=US
YOUTUBE_RESEARCH_LANGUAGE=en
YOUTUBE_RESEARCH_ORDER=viewCount

TTS_PROVIDER=openai_tts
VISUAL_PROVIDER=openai_image
VISUAL_ENDPOINT=
VISUAL_API_KEY=
VISUAL_MODEL=

OUTPUT_DIR=./data/output
WORKFLOW_ENABLED=true
WORKFLOW_POLL_SECONDS=1
WORKFLOW_LEASE_SECONDS=1800
RESEARCH_SCHEDULER_ENABLED=true
RESEARCH_SCHEDULER_POLL_SECONDS=30
RESEARCH_SCHEDULER_BATCH_SIZE=3
RESEARCH_SCHEDULER_LEASE_MINUTES=20
METRICS_PUBLIC=false
METRICS_AUTH_TOKEN_FILE=/app/secrets/metrics_token
READINESS_TIMEOUT_SECONDS=3
PROVIDER_HEALTH_ENABLED=true

# Billing
BILLING_PROVIDER=stripe
BILLING_CURRENCY=USD
BILLING_WEBHOOK_SECRET=
BILLING_RETURN_URL=https://app.example.com/billing
BILLING_WEBHOOK_SECRETS=
BILLING_WEBHOOK_TOLERANCE_SECONDS=300
STRIPE_SECRET_KEY=
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_TIMEOUT_SECONDS=20
STRIPE_PRICE_CREATOR=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=

# Privacy / retention
AUDIT_RETENTION_DAYS=730
USAGE_RETENTION_DAYS=400
AUTH_SESSION_RETENTION_DAYS=90
LOGIN_RATE_LIMIT_RETENTION_DAYS=2
PRIVACY_REQUEST_RETENTION_DAYS=730
BILLING_RETENTION_DAYS=2555
PRIVACY_EXPORT_MAX_EVENTS=10000
MAINTENANCE_POLL_SECONDS=300

IMAGE_PROVIDER=openai_image
IMAGE_ENDPOINT=https://api.openai.com/v1
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-2
PEXELS_API_KEY=
VIDEO_PROVIDER=runway
VIDEO_ENDPOINT=https://api.dev.runwayml.com/v1
VIDEO_API_KEY=
RUNWAY_API_KEY=
VIDEO_MODEL=gen4.5
VIDEO_POLL_SECONDS=5
VIDEO_TIMEOUT_SECONDS=900
TTS_PROVIDER=elevenlabs
TTS_ENDPOINT=https://api.elevenlabs.io/v1
TTS_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TTS_MODEL=eleven_flash_v2_5
TTS_VOICE=
TTS_INSTRUCTIONS=
THUMBNAIL_PROVIDER=openai_image

OPTIMIZATION_AI_ENABLED=true
OPTIMIZATION_MIN_CONFIDENCE=0.60
OPTIMIZATION_DEFAULT_MAX_ACTIONS=3
OPTIMIZATION_AUTO_EXECUTE=false
EXECUTION_CONTROLLER_ENABLED=true
EXECUTION_REQUIRE_QUALITY_GATE=true
EXECUTION_DEFAULT_RESERVATION_TTL_MINUTES=120
EXECUTION_MAX_REVISIONS_PER_DAY=5

POSTPUBLISH_ENABLED=true
POSTPUBLISH_POLL_SECONDS=60

CREATIVE_INTELLIGENCE_ENABLED=true
CREATIVE_FRAME_INTERVAL_SECONDS=3
CREATIVE_MAX_FRAMES=12
CREATIVE_SIMILARITY_THRESHOLD=0.08
VISION_PROVIDER=openai_responses_vision
VISION_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=gpt-5.6-luna
VISION_TIMEOUT_SECONDS=60

MULTIMODAL_GRAPH_ENABLED=true
MULTIMODAL_VISION_ENABLED=true
MULTIMODAL_MAX_FRAMES=8
MULTIMODAL_PREFLIGHT_HARD_FAIL=true

# v3.9 Agent Governance
GOVERNANCE_ENABLED=true
GOVERNANCE_APPROVAL_TIMEOUT_MINUTES=120
GOVERNANCE_DEFAULT_MODE=approve
GOVERNANCE_GLOBAL_KILL_SWITCH=false
