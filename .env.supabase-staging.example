APP_ENV=staging
APP_VERSION=4.2.1
DEPLOYMENT_ENV=staging
RELEASE_ID=staging-supabase
AUTO_MIGRATE=false
SCHEMA_GATE_ENABLED=true

# Supabase staging project
SUPABASE_PROJECT_REF=pgxjiibgfhvtdgbehpid
SUPABASE_DB_HOST=aws-0-eu-central-1.pooler.supabase.com
SUPABASE_DB_USER=postgres.pgxjiibgfhvtdgbehpid
# Replace only this password locally. Never commit the real value.
DATABASE_URL=postgresql+asyncpg://postgres.pgxjiibgfhvtdgbehpid:REPLACE_WITH_DATABASE_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

PUBLIC_BASE_URL=http://localhost:8001
FRONTEND_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# Staging-safe application settings
APP_ENCRYPTION_KEY=staging-only-not-for-production
AUTH_DEV_FALLBACK=false
AUTH_SESSION_TTL_DAYS=1
API_KEY_DEFAULT_TTL_DAYS=1

BILLING_PROVIDER=mock
BILLING_CURRENCY=USD
BILLING_RETURN_URL=http://localhost:3001/billing

LLM_PROVIDER=mock
RESEARCH_PROVIDER=mock
TTS_PROVIDER=espeak
VISUAL_PROVIDER=mock_png
IMAGE_PROVIDER=mock_png
VIDEO_PROVIDER=mock_video
THUMBNAIL_PROVIDER=pillow

WORKFLOW_ENABLED=true
WORKFLOW_POLL_SECONDS=0.5
WORKFLOW_LEASE_SECONDS=600
RESEARCH_SCHEDULER_ENABLED=false

POSTPUBLISH_ENABLED=true
POSTPUBLISH_POLL_SECONDS=60

CREATIVE_INTELLIGENCE_ENABLED=true
MULTIMODAL_GRAPH_ENABLED=true
MULTIMODAL_VISION_ENABLED=true
MULTIMODAL_PREFLIGHT_HARD_FAIL=true

OPTIMIZATION_AI_ENABLED=true
OPTIMIZATION_AUTO_EXECUTE=false

GOVERNANCE_ENABLED=true
GOVERNANCE_DEFAULT_MODE=approve
GOVERNANCE_GLOBAL_KILL_SWITCH=false

OUTPUT_DIR=./data/output